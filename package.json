{
  "name": "syntype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.admin.config.ts && node scripts/build-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:page": "node scripts/build-page.mjs",
    "build:gallery": "node scripts/build-gallery.mjs",
    "deploy": "wrangler d1 migrations apply syntype --remote && wrangler deploy",
    "dev:api": "npm run build && wrangler d1 migrations apply syntype --local && wrangler dev --var ADMIN_DEV_EMAIL:admin@localhost --var TURNSTILE_SITE_KEY:1x00000000000000000000BB",
    "visual:fixtures": "node scripts/visual/run.mjs scripts/visual/make-fixtures.ts",
    "check:visual": "node scripts/visual/run.mjs scripts/visual/capture.ts",
    "check:a11y": "node scripts/visual/run.mjs scripts/visual/a11y.ts",
    "bench:keys": "node scripts/visual/run.mjs scripts/visual/bench.ts",
    "ui:add": "node scripts/ui-add.ts",
    "check:controls": "node scripts/visual/run.mjs scripts/visual/controls.ts",
    "check:csp": "node scripts/visual/run.mjs scripts/visual/csp.ts",
    "report:size": "node scripts/visual/run.mjs scripts/visual/size.ts",
    "bench:restyle": "node scripts/visual/run.mjs scripts/visual/restyle.ts",
    "bench:renders": "node scripts/visual/run.mjs scripts/visual/renders.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "ts-lang": "npm:typescript@6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.1.1",
    "axe-core": "4.14.1",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
