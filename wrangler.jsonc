// Cloudflare deployment: the built site (npm run build -> dist/) served as a
// Worker's static assets. There is no Worker code; every file is served as is.
// Deploy with `npx wrangler deploy` after `npm run build`, or connect the
// GitHub repository in the Cloudflare dashboard (Workers Builds) to deploy on
// every push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syntype",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist"
  }
}
