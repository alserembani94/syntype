# Response headers for Cloudflare's static assets (copied into dist/ by Vite).
# Built files under /assets/ have a content hash in their names, so they can be
# cached for a year; index.html is not, so a new deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin-assets/*
  Cache-Control: public, max-age=31536000, immutable

# The admin page (behind Cloudflare Access): never cached. (Framing is refused
# for every page below; a header repeated in two matching rules is joined with a
# comma, which would make X-Frame-Options invalid here.)
/admin
  Cache-Control: no-store

# The design system gallery, also behind Access (it holds no data).
/admin/*
  Cache-Control: no-store

# Every page: never framed by another site, HTTPS only, no device access, and a
# Content Security Policy. Its placeholder line is filled in by scripts/build-pages.mjs with
# hashes of the pages' own inline code, so the policy matches what was built.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  __CSP__
