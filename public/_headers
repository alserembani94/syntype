# Response headers for Cloudflare's static assets (copied into dist/ by Vite).
# Built files under /assets/ have a content hash in their names, so they can be
# cached for a year; index.html is not, so a new deploy shows up at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin-assets/*
  Cache-Control: public, max-age=31536000, immutable

# The admin page (behind Cloudflare Access): never framed, never cached.
/admin
  X-Frame-Options: DENY
  Cache-Control: no-store

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
